rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Everyone can READ (public website, no login).
      allow read: if true;

      // Only the admin account can CREATE / UPDATE / DELETE.
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "w1oMfha7SpV6ogBMDNNGNLDplXs2";
    }
  }
}
